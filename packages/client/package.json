{
  "name": "@bazilion/client",
  "version": "0.9.0",
  "description": "HTTP client for the Bazilion daemon. Zero node-only deps — works in browsers, React Native, and Node.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rullopat/bazilion.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/rullopat/bazilion#readme",
  "bugs": {
    "url": "https://github.com/rullopat/bazilion/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@bazilion/api-types": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
