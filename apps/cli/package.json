    "@mozilla/readability": "^0.6.0",
    "@tobilu/qmd": "^2.1.0",
    "adm-zip": "^0.5.17",
    "citty": "^0.1.6",
    "hono": "^4.6.0",
    "linkedom": "^0.18.12",
    "qrcode-terminal": "^0.12.0",
    "typebox": "^1.1.32",
