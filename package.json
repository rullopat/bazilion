{
  "name": "bazilion-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^26.12.1"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && pnpm --filter @bazilion/web typecheck",
    "test": "vitest run apps/daemon/test/lib/browser-live.test.ts --maxWorkers=1 --no-file-parallelism && vitest run --exclude apps/daemon/test/lib/browser-live.test.ts",
    "test:upgrade-harness": "node --test scripts/testing/upgrade-harness.test.mjs",
    "security:acceptance": "node scripts/security-acceptance.mjs",
    "build": "pnpm --filter @bazilion/web build && pnpm -r --filter @bazilion/api-types --filter @bazilion/client --filter bazilion run build",
    "build:packages": "pnpm -r --filter='./packages/*' --filter='./apps/cli' run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^26.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "typebox": "^1.3.0"
  }
}
